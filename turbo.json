{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NOTION_API_KEY",
    "NOTION_DATABASE_ID",
    "NEXT_PUBLIC_GISCUS_REPO",
    "NEXT_PUBLIC_GISCUS_REPO_ID",
    "NEXT_PUBLIC_GISCUS_CATEGORY",
    "NEXT_PUBLIC_GISCUS_CATEGORY_ID"
  ],
  "globalPassThroughEnv": ["NODE_ENV", "REVALIDATE_SECRET", "VIEW_HASH_SALT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
